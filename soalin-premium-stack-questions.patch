diff --git a/scripts/build-stacks.cjs b/scripts/build-stacks.cjs
new file mode 100644
index 0000000..752bba4
--- /dev/null
+++ b/scripts/build-stacks.cjs
@@ -0,0 +1,39 @@
+// Scan images/stacks/<nama>/ (termasuk subfolder) dan tulis data/stacks.js.
+// Pakai: node scripts/build-stacks.cjs
+// Contoh: images/stacks/brain-lobes/sagittal/*.jpg  →  key "brain-lobes/sagittal"
+const fs = require("fs");
+const path = require("path");
+
+const ROOT = path.join(__dirname, "..");
+const STACK_DIR = path.join(ROOT, "images", "stacks");
+const OUT = path.join(ROOT, "data", "stacks.js");
+const EXT = /\.(jpe?g|png|webp|gif)$/i;
+
+if (!fs.existsSync(STACK_DIR)) {
+  console.error("Folder images/stacks belum ada. Buat dulu, lalu taruh folder gambar di dalamnya.");
+  process.exit(1);
+}
+
+const stacks = {};
+function walk(dir) {
+  const entries = fs.readdirSync(dir, { withFileTypes: true });
+  const imgs = entries
+    .filter((e) => e.isFile() && EXT.test(e.name))
+    .map((e) => e.name)
+    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
+  if (imgs.length && dir !== STACK_DIR) {
+    const key = path.relative(STACK_DIR, dir).split(path.sep).join("/");
+    stacks[key] = imgs.map((n) => `images/stacks/${key}/${n}`);
+  }
+  for (const e of entries) if (e.isDirectory()) walk(path.join(dir, e.name));
+}
+walk(STACK_DIR);
+
+fs.writeFileSync(
+  OUT,
+  "// Dibuat otomatis oleh scripts/build-stacks.cjs — jangan diedit manual.\n" +
+    "window.STACKS = " + JSON.stringify(stacks, null, 2) + ";\n"
+);
+
+console.log(`Stack ditemukan: ${Object.keys(stacks).length}`);
+for (const [k, v] of Object.entries(stacks)) console.log(`  ${k} (${v.length} gambar)`);
diff --git a/scripts/crop-stacks.cjs b/scripts/crop-stacks.cjs
new file mode 100644
index 0000000..1db49cf
--- /dev/null
+++ b/scripts/crop-stacks.cjs
@@ -0,0 +1,43 @@
+// Potong bagian atas (legenda warna) dari semua gambar di images/stacks-raw/,
+// tulis hasilnya ke images/stacks/ dengan struktur folder yang sama, lalu jalankan build-stacks.
+// Pakai:  node scripts/crop-stacks.cjs            (potong 30% dari atas)
+//         node scripts/crop-stacks.cjs 0.25       (potong 25% dari atas)
+const fs = require("fs");
+const path = require("path");
+const sharp = require("sharp");
+
+const ROOT = path.join(__dirname, "..");
+const RAW = path.join(ROOT, "images", "stacks-raw");
+const OUT = path.join(ROOT, "images", "stacks");
+const CROP_TOP = Number(process.argv[2] || 0.30); // fraksi tinggi gambar yang dipotong dari atas
+const EXT = /\.(jpe?g|png|webp|gif)$/i;
+
+if (!fs.existsSync(RAW)) {
+  console.error("Folder images/stacks-raw belum ada. Taruh folder hasil scraper di sana.");
+  process.exit(1);
+}
+
+async function run() {
+  let count = 0;
+  async function walk(dir) {
+    for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+      const src = path.join(dir, e.name);
+      if (e.isDirectory()) { await walk(src); continue; }
+      if (!EXT.test(e.name)) continue;
+      const rel = path.relative(RAW, src);
+      const dst = path.join(OUT, rel);
+      fs.mkdirSync(path.dirname(dst), { recursive: true });
+      const meta = await sharp(src).metadata();
+      const top = Math.round(meta.height * CROP_TOP);
+      await sharp(src)
+        .extract({ left: 0, top, width: meta.width, height: meta.height - top })
+        .toFile(dst);
+      count++;
+    }
+  }
+  await walk(RAW);
+  console.log(`Dipotong ${count} gambar (${Math.round(CROP_TOP * 100)}% dari atas) -> images/stacks/`);
+  require("./build-stacks.cjs");
+}
+
+run().catch((err) => { console.error(err); process.exit(1); });
